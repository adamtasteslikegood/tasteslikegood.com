  "instructions": [
    {
      "step": 1,
      "description": "In a medium bowl, whisk together the plant milk and apple cider vinegar. Let it sit for 5 minutes to curdle and form vegan buttermilk."
    },
    {
      "step": 2,
      "description": "Whisk the melted coconut oil, maple syrup, and vanilla extract into the buttermilk mixture."
    },
    {
      "step": 3,
      "description": "In a large mixing bowl, sift together the all-purpose flour, baking powder, and salt."
    },
    {
      "step": 4,
      "description": "Pour the wet ingredients into the dry ingredients. Stir gently until just combined. Do not overmix; a few lumps are perfectly fine. Let the batter rest for 5 minutes."
    },
    {
      "step": 5,
      "description": "Heat a non-stick skillet or griddle over medium heat. Lightly grease with a little coconut oil or vegan butter."
    },
    {
      "step": 6,
      "description": "Pour about 1/4 cup of batter onto the skillet for each pancake. Cook for 2-3 minutes until bubbles form on the surface and the edges look set."
    },
    {
      "step": 7,
      "description": "Flip carefully and cook for another 1-2 minutes until golden brown on the bottom."
    },
    {
      "step": 8,
      "description": "Serve warm, topped with a pat of vegan butter and a generous drizzle of maple syrup."
    }
  ],
  "notes": "For extra fluffy pancakes, make sure not to overmix the batter. You can also fold in vegan chocolate chips or fresh blueberries right before cooking.",
