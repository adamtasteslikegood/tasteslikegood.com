        "name": "Baking powder",
        "amount": 1,
        "units": "Tbsp"
      },
      {
        "name": "Salt",
        "amount": 0.25,
        "units": "tsp"
      }
    ],
    "other": [
      {
        "name": "Maple syrup",
        "amount": 0.5,
        "units": "cup",
        "notes": "for serving"
