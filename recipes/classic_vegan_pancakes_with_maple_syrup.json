{
  "name": "Classic Vegan Pancakes with Maple Syrup",
  "description": "Light, fluffy, and perfectly golden vegan pancakes, served with a generous drizzle of rich maple syrup.",
  "prepTime": 10,
  "cookTime": 15,
  "servings": 4,
  "ingredients": {
    "wet": [
      {
        "name": "Plant milk (almond, soy, or oat)",
        "amount": 1.5,
        "units": "cup",
        "notes": "room temperature"
      },
      {
