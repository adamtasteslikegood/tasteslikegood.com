  "instructions": [
    {
      "step": 1,
      "description": "Heat the olive oil in a large heavy-bottomed pot or Dutch oven over medium heat."
    },
    {
      "step": 2,
      "description": "Add the diced onion, carrots, and celery. Saut\u00e9 for 5-7 minutes until the onions are translucent and the vegetables begin to soften."
    },
    {
      "step": 3,
      "description": "Stir in the minced garlic, smoked paprika, and dried thyme. Cook for 1 minute, stirring constantly, until fragrant."
    },
    {
      "step": 4,
      "description": "Add the chunky diced potatoes, vegetable broth, and tamari. Bring the soup to a gentle boil."
    },
    {
      "step": 5,
      "description": "Reduce the heat to a simmer, cover the pot, and cook for 15-20 minutes, or until the potatoes are fork-tender."
    },
    {
      "step": 6,
      "description": "To create a creamy base while retaining the chunky texture, use an immersion blender to pulse the soup 4-5 times. Alternatively, carefully transfer 2 cups of the soup to a stand blender, blend until completely smooth, and stir it back into the pot."
    },
    {
      "step": 7,
      "description": "Pour in the coconut milk, frozen corn, and nutritional yeast. Stir well and simmer for another 5 minutes until the corn is heated through and the soup thickens."
    },
    {
      "step": 8,
      "description": "Taste and adjust the seasoning with salt and black pepper. Serve hot, garnished with fresh herbs, green onions, or vegan bacon bits if desired."
    }
  ],
  "notes": "For a nuttier flavor, you can substitute the coconut milk with cashew cream (blend 1 cup of soaked raw cashews with 1 cup of water until completely smooth). Serve with a side of warm, crusty sourdough bread for dipping.",
