# =============================================================================
# TASTES LIKE GOOD - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Google Cloud - OAuth 2.0 Credentials (REQUIRED)
# -----------------------------------------------------------------------------
# Get these from: https://console.cloud.google.com/apis/credentials
# 1. Create OAuth 2.0 Client ID (Web application)
# 2. Add authorized redirect URI: http://localhost:5000/auth/callback
# 3. Add authorized JavaScript origin: http://localhost:5000
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# -----------------------------------------------------------------------------
# Google Cloud - Gemini API Key (REQUIRED)
# -----------------------------------------------------------------------------
# Get your key from: https://makersuite.google.com/app/apikey
# or: https://console.cloud.google.com/apis/credentials
# Requires: Generative Language API enabled
GOOGLE_API_KEY=your_google_ai_api_key_here

# Override the default Gemini model used for recipe generation.
# Defaults to gemini-3.1-pro-preview when unset or empty.
# GEMINI_DEFAULT_MODEL=gemini-3.1-pro-preview

# -----------------------------------------------------------------------------
# Flask Configuration
# -----------------------------------------------------------------------------
# Secret key for session encryption
# Generate with: python -c "import os; print(os.urandom(24).hex())"
# If not set, a random key will be generated (sessions won't persist on restart)
FLASK_SECRET_KEY=your_flask_secret_key_here

# -----------------------------------------------------------------------------
# Unsplash API (OPTIONAL)
# -----------------------------------------------------------------------------
# For stock food images while AI images generate
# Free tier: 50 requests/hour
# Get your key at: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# -----------------------------------------------------------------------------
# Cache Configuration (OPTIONAL)
# -----------------------------------------------------------------------------
# Time-to-live for recipe list cache in seconds
# Default: 60 seconds
# RECIPES_CACHE_TTL=60

# -----------------------------------------------------------------------------
# Database Configuration (PHASE 3)
# -----------------------------------------------------------------------------
# PostgreSQL connection string (recommended for production):
# DATABASE_URL=postgresql://username:password@localhost:5432/tasteslikegood
#
# SQLite for local development (default if not set):
# DATABASE_URL=sqlite:///tasteslikegood.db
#
# Note: For Heroku/GCP, postgres:// URLs are automatically converted to postgresql://
DATABASE_URL=sqlite:///tasteslikegood.db

# -----------------------------------------------------------------------------
# Async generation and image workers
# -----------------------------------------------------------------------------
# Required for Pub/Sub publishing and OIDC-authenticated push handlers in
# deployed environments. Production values are injected by cloudbuild.yaml.
# GCP_PROJECT_ID=comdottasteslikegood
# PUBSUB_INVOKER_SA=pubsub-pusher@comdottasteslikegood.iam.gserviceaccount.com
# GCS_BUCKET_NAME=tasteslikegood-recipe-images

# Number of transient recipe-generation attempts before recording an error.
# GENERATION_MAX_ATTEMPTS=3

# Bound one Gemini/Imagen HTTP call below the Pub/Sub acknowledgement deadline.
# GENAI_HTTP_TIMEOUT_MS=540000

# Reclaim abandoned worker claims after one Pub/Sub delivery lease.
# WORKER_CLAIM_STALE_SECONDS=600

# Local emulator/tests only. Never enable this in a publicly reachable service:
# it bypasses OIDC verification on /api/worker/*.
# PUBSUB_AUTH_OPTIONAL=1

# -----------------------------------------------------------------------------
# Operational safeguards
# -----------------------------------------------------------------------------
# Protects admin-only migration and image-diagnostic operations.
# Generate a long random value and inject it from Secret Manager in production.
# ADMIN_API_TOKEN=your_admin_api_token_here

# One-time release migration option: reassign legacy guest-published recipes to
# this existing user email instead of unpublishing them.
# GUEST_PUBLIC_REASSIGN_EMAIL=owner@example.com

# -----------------------------------------------------------------------------
# Datadog (PRODUCTION ONLY)
# -----------------------------------------------------------------------------
# The Docker image wraps the app in datadog serverless-init + ddtrace-run,
# which require a Datadog API key at runtime to ship traces, profiles, logs,
# and AppSec events. Without it the app still runs but telemetry is dropped.
# In production the key comes from Google Secret Manager (DD_API_KEY) via
# --set-secrets in the cookbook repo's cloudbuild.yaml — never put it here.
# Local dev servers (python app.py / flask run) don't use the entrypoint and
# don't need it.
# DD_API_KEY=your_datadog_api_key_here

# -----------------------------------------------------------------------------
# Development Settings (OPTIONAL)
# -----------------------------------------------------------------------------
# Allow OAuth over HTTP (for local development only)
# This is set automatically in auth.py for development
# OAUTHLIB_INSECURE_TRANSPORT=1

# Flask debug mode (automatically enabled when running app.py)
# FLASK_DEBUG=1

# -----------------------------------------------------------------------------
# Valkey/Redis response cache (OPTIONAL)
# -----------------------------------------------------------------------------
# Used for caching recipe images and other responses via Flask-Caching.
# Unset = in-process SimpleCache (fine for local dev).
# Production (Cloud Run) injects VALKEY_HOST + VALKEY_AUTH_MODE=iam.
#VALKEY_HOST=10.128.0.11
#VALKEY_PORT=6379
#VALKEY_AUTH_MODE=iam
# Only for VALKEY_AUTH_MODE=password:
#VALKEY_PASSWORD=your_valkey_password_here
# Local docker alternative (used only when VALKEY_HOST is unset):
#REDIS_URL=redis://localhost:6379/0
