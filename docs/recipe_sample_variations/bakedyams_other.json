        {
            "step": 2,
            "description": "Rub yams with melted coconut oil and sprinkle with cinnamon and nutmeg."
        },
        {
            "step": 3,
            "description": "Place yams on a baking sheet and bake for 30-40 minutes, or until fork-tender."
