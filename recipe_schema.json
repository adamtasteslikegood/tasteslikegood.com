{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Recipe",
  "description": "Schema for a cooking recipe",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the recipe"
    },
    "pantry_matches": {"type": "array", "items": {"type": "object"}},
    "pantry_stretchables": {"type": "array", "items": {"type": "object"}},
    "missing_items": {"type": "array", "items": {"type": "object"}},
    "shopping_delta": {"type": "array", "items": {"type": "object"}},
    "tools_equipment": {"type": "array", "items": {"type": "string"}},
    "difficulty": {"type": "string"},
    "prep_time_minutes": {"type": "integer"},
    "cook_time_minutes": {"type": "integer"},
    "total_time_minutes": {"type": "integer"},
    "nutrition": {"type": "object"},
    "agents_involved": {"type": "array", "items": {"type": "string"}},
    "run_id": {"type": "string"},
    "agent_trace": {"type": "array", "items": {"type": "object"}},
    "rating": {"type": ["number", "null"]},
    "notes": {"type": "array", "items": {"type": "string"}},
    "collections": {"type": "array", "items": {"type": "string"}},
    "tags": {"type": "array", "items": {"type": "string"}},
    "variant_of": {"type": ["string", "null"]},
    "version": {"type": ["string", "integer", "null"]},
    "stock_image_url": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri",
      "description": "URL of a stock image for the recipe"
    },
    "ai_image_url": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri",
      "description": "URL of an AI-generated image for the recipe"
    },
    "description": {
      "type": "string",
      "description": "Short description of the recipe"
    },
    "prepTime": {
      "type": "integer",
      "description": "Preparation time in minutes"
    },
    "cookTime": {
      "type": "integer",
      "description": "Cooking time in minutes"
    },
    "servings": {
      "type": "integer",
      "description": "Number of servings the recipe yields"
    },
    "ingredients": {
      "type": "object",
      "description": "Ingredients grouped by type (wet, dry, etc.)",
      "properties": {
        "wet": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ingredient"
          }
        },
        "dry": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ingredient"
          }
        },
        "other": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ingredient"
          },
          "description": "Optional group for ingredients that don't fit in wet or dry"
        }
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "#/definitions/ingredient"
        }
      },
      "required": [
        "wet",
        "dry"
      ]
    },
    "instructions": {
      "type": "array",
      "description": "Ordered list of instructions",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "properties": {
              "step": {
                "type": "integer",
                "minimum": 1,
                "description": "Step number in the sequence"
              },
              "description": {
                "type": "string",
                "description": "Instructional text for the step"
              }
            },
            "required": [
              "description"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "notes": {
      "type": "string",
      "description": "Optional notes, tips, or variations"
    },
    "tags": {
      "type": "array",
      "description": "Keywords or tags for searching and filtering",
      "items": {
        "type": "string"
      }
    },
    "image_keywords": {
      "type": "array",
      "description": "Keywords optimized for stock photo searches (e.g., 'vegan curry bowl', 'colorful salad')",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "maxItems": 5
    },
    "image": {
      "type": "string",
      "format": "uri",
      "description": "Optional URL of an image of the finished dish"
    },
    "user_id": {
      "type": "string",
      "description": "ID of the user who generated the recipe, or 'anonymous'"
    },
    "ai_metadata": {
      "type": "object",
      "description": "Metadata about all AI generation processes",
      "properties": {
        "recipe_generation": {
          "type": "object",
          "description": "Metadata for the recipe text generation",
          "properties": {
            "model": { "type": "string", "description": "Model used for generation" },
            "user_id": { "type": "string", "description": "User who triggered the generation" },
            "prompt": { "type": "string", "description": "Original user prompt" },
            "timestamp": { "type": "string", "description": "ISO timestamp of generation" },
            "success": { "type": "boolean", "description": "Whether generation succeeded" }
          }
        },
        "image_generation": {
          "type": ["object", "null"],
          "description": "Metadata for AI image generation (Imagen)",
          "properties": {
            "model": { "type": "string", "description": "Model used for image generation" },
            "user_id": { "type": "string", "description": "User who triggered the generation" },
            "prompt": { "type": "string", "description": "Image generation prompt" },
            "timestamp": { "type": "string", "description": "ISO timestamp of generation" },
            "success": { "type": "boolean", "description": "Whether generation succeeded" },
            "image_path": { "type": ["string", "null"], "description": "Path to generated image" }
          }
        },
        "stock_image_generation": {
          "type": ["object", "null"],
          "description": "Metadata for stock image URL generation",
          "properties": {
            "model": { "type": "string", "description": "Model used to find stock image" },
            "user_id": { "type": "string", "description": "User who triggered the generation" },
            "prompt": { "type": "string", "description": "Prompt used to find stock image" },
            "timestamp": { "type": "string", "description": "ISO timestamp of generation" },
            "success": { "type": "boolean", "description": "Whether a valid URL was found" },
            "url_validated": { "type": "boolean", "description": "Whether the URL was validated as working" }
          }
        },
        "model": {
          "type": "string",
          "description": "Legacy: Primary model used (for backwards compatibility)"
        },
        "timestamp": {
          "type": "string",
          "description": "Legacy: Primary timestamp (for backwards compatibility)"
        },
        "prompt": {
          "type": "string",
          "description": "Legacy: Primary prompt (for backwards compatibility)"
        },
        "images_working": {
          "type": "boolean",
          "description": "Whether images are currently working/valid"
        }
      }
    }
  },
  "required": [
    "name",
    "prepTime",
    "cookTime",
    "servings",
    "ingredients",
    "instructions"
  ],
  "definitions": {
    "ingredient": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the ingredient"
        },
        "amount": {
          "type": [
            "number",
            "array"
          ],
          "description": "Amount of the ingredient. Can be a single number or an array for a range.",
          "items": {
            "type": "number"
          }
        },
        "units": {
          "type": "string",
          "description": "Unit of measurement"
        },
        "notes": {
          "type": "string",
          "description": "Optional preparation notes, such as chopped, sliced, etc."
        }
      },
      "required": [
        "name",
        "amount",
        "units"
      ]
    }
  }
}
